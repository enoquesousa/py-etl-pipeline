# IMPORTANT: Do NOT commit real secrets. Replace values below with
# placeholders or keep them blank. Store real secrets in a local
# `.env` file which must be listed in `.gitignore`.

# Option A — optional complete URL; leave unset when using the fields below.
# Percent-encode credentials yourself only when supplying a full URL.
# Example: postgresql://<user>:<password>@127.0.0.1:5432/<database>
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5433/<database>

# Option B — discrete variables (used only when DATABASE_URL is unset)
POSTGRES_USER=postgres
# Required: fill in a strong password locally; there is no default password.
# Quote dotenv values when needed, especially values containing # or spaces.
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=data-py

# Optional GraphQL probe: 0 restricts access to local clients; 1 deliberately
# publishes health/version/non-secret runtime hints without authentication.
# ETL_GRAPHQL_PUBLIC=0

# Optional: print SQL to stderr (true | 1 | yes)
# SQLALCHEMY_ECHO=false

# Optional: rows per batch for bulk insert / PostgreSQL upsert (default 500)
# LOAD_BATCH_SIZE=500
